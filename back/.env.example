# Copiar este archivo como ".env" y completar los valores. El .env NO se sube a GitHub.

PORT=3000

# MongoDB Atlas -> Database -> Connect -> Drivers. Reemplazar <usuario>, <clave> y el host del cluster.
# El "/tribuna" antes del "?" es el nombre de la base de datos.
MONGO_URI=mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/tribuna?retryWrites=true&w=majority

# Origen(es) del front que tienen permitido llamar a la API (CORS). Varios separados por coma.
FRONT_URL=http://localhost:4200

# Secreto con el que se firman los tokens JWT. Un texto largo y aleatorio (en Render: botón "Generate").
JWT_SECRET=

# Cloudinary -> Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: zona horaria en la que contesta la API de promiedos (la deduce por la IP del servidor).
# En la PC (Argentina) no hace falta. En Render (servidor en EE.UU.): America/New_York
# PROMIEDOS_ZONA_HORARIA=America/New_York

# Opcional: solo si al conectar a Atlas aparece "querySrv ECONNREFUSED" (DNS que no resuelve SRV).
# Es el mismo workaround que usa el profe en sus ejemplos.
# DNS_SERVERS=8.8.8.8,1.1.1.1
